    { "from": "ncu_profile", "to": "sm100_decision", "label": "H12 仅 12 个 CTA", "variant": "emphasis", "role": "branch" },
    { "from": "correctness", "to": "sm100_decision", "label": "580 项通过", "variant": "emphasis", "role": "branch" }
