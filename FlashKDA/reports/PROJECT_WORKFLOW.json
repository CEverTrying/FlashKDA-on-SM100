    { "id": "correctness", "lane": "evidence", "col": 5, "type": "security", "label": "正确性与精度", "sublabel": "torch_ref · FLA · 580 case", "width": 126 },
    { "id": "sm100_decision", "lane": "decision", "col": 5, "type": "messagebus", "label": "当前 SM100 判断", "sublabel": "保留现有 kernel，优先研究 K2 两 CTA", "tag": "负结果可交付", "width": 154 }
