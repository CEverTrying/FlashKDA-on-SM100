    { "id": "k1", "lane": "kernel", "col": 2, "type": "backend", "label": "K1 prepare", "sublabel": "chunk 内计算与 Neumann 求逆", "tag": "grid 大", "width": 126 },
    { "id": "workspace", "lane": "kernel", "col": 3, "type": "database", "label": "Workspace", "sublabel": "保存 K2 所需中间量", "tag": "TMA 搬运" },
