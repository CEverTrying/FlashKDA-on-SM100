    { "dot": "amber", "title": "主要发现", "items": ["CHUNK 16 同时受数值范围与求逆成本约束", "TCGEN05 最小 M64 让 C16 浪费四分之三算术", "TP8 fixed H12 的 K2 首先缺少独立工作"] },
    { "dot": "cyan", "title": "当前边界", "items": ["尚无端到端 sm100a FlashKDA candidate", "下一项原型是按 value 列拆成两个 CTA", "原型需通过 H96、H12 和 580 case 三道检查"] }
  ]
